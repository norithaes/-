#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <string.h>

#define MAX_ITEMS 5
#define NAME_LENGTH 30

char item_names[MAX_ITEMS][NAME_LENGTH];
int item_stocks[MAX_ITEMS];
int item_total_in[MAX_ITEMS];
int item_total_out[MAX_ITEMS];

void initialize_program() {
    for (int i = 0; i < MAX_ITEMS; i++) {
        sprintf(item_names[i], "상품%d", i + 1);
        item_stocks[i] = 0;
        item_total_in[i] = 0;
        item_total_out[i] = 0;
    }
    printf("--- 쇼핑몰 재고 관리 프로그램 시작 ---\n");
    printf("5개 상품의 데이터가 초기화되었습니다.\n");
}

void clear_input_buffer() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

void display_status() {
    int total_stock = 0;
    int total_sales = 0;
    int max_sales = -1;
    int max_sales_id = -1;

    printf("\n--- 3. 상품현황 ---\n");

    for (int i = 0; i < MAX_ITEMS; i++) {
        total_stock += item_stocks[i];
        total_sales += item_total_out[i];

        if (item_total_out[i] > max_sales) {
            max_sales = item_total_out[i];
            max_sales_id = i + 1;
        }
    }

    printf("총 재고수량 : %d\n", total_stock);
    printf("총 판매량 : %d\n", total_sales);

    if (max_sales_id != -1 && max_sales > 0) {
        printf("가장 많이 판매된 상품 : ID %d [%s], 판매량 %d\n",
            max_sales_id, item_names[max_sales_id - 1], max_sales);
    }

    printf("\n--- 개별 상품 재고 현황 ---\n");
    for (int i = 0; i < MAX_ITEMS; i++) {
        int item_id = i + 1;
        printf("ID %d 상품명: [%s], 현재 재고: %d, 총 판매량: %d\n",
            item_id, item_names[i], item_stocks[i], item_total_out[i]);

        if (item_stocks[i] == 0) {
            printf("  -> 재고부족(0)\n");
        }
        else if (item_stocks[i] < 5) {
            printf("  -> 재고부족(%d)\n", item_stocks[i]);
        }
    }
    printf("---------------------------\n");
}

int main() {
    int choice;
    initialize_program();

    while (1) {
        printf("\n[쇼핑몰 관리 프로그램]\n");
        printf("원하는 메뉴를 선택하세요.(1. 입고, 2. 판매, 3. 상품현황, 4. 종료) : ");

        if (scanf("%d", &choice) != 1) {
            printf("! 잘못된 입력입니다.\n");
            clear_input_buffer();
            continue;
        }
        clear_input_buffer();

        switch (choice) {
        case 1: {
            int sub_choice;
            printf("\n(출력)입고수량 입력 : 전체 상품 입고수량 입력 1, 개별 상품 입력 2를 선택\n");
            printf(">");
            scanf("%d", &sub_choice);
            clear_input_buffer();

            if (sub_choice == 1) {
                int input_qty[MAX_ITEMS];
                printf("입력(공백으로 구분하여 5개 숫자 입력) : ");
                for (int i = 0; i < MAX_ITEMS; i++) {
                    scanf("%d", &input_qty[i]);
                }
                clear_input_buffer();

                for (int i = 0; i < MAX_ITEMS; i++) {
                    item_stocks[i] += input_qty[i];
                    item_total_in[i] += input_qty[i];
                }
                printf("-> 전체 상품 입고 완료\n");
            }
            else if (sub_choice == 2) {
                int id, qty;
                printf("(입력)상품ID : ");
                scanf("%d", &id);
                clear_input_buffer();
                printf("(입력)입고수량 : ");
                scanf("%d", &qty);
                clear_input_buffer();

                if (id >= 1 && id <= MAX_ITEMS) {
                    item_stocks[id - 1] += qty;
                    item_total_in[id - 1] += qty;
                    printf("-> 상품 ID %d 입고 완료. 현재 재고: %d\n", id, item_stocks[id - 1]);
                }
                else {
                    printf("! 잘못된 상품 ID\n");
                }
            }
            break;
        }
        case 2: {
            int sub_choice;
            printf("\n(출력)판매수량 입력 : 전체 상품 판매수량 입력 1, 개별 상품 입력 2를 선택\n");
            printf(">");
            scanf("%d", &sub_choice);
            clear_input_buffer();

            if (sub_choice == 1) {
                int sell_qty[MAX_ITEMS];
                printf("입력(공백으로 구분하여 5개 숫자 입력) : ");
                for (int i = 0; i < MAX_ITEMS; i++) {
                    scanf("%d", &sell_qty[i]);
                }
                clear_input_buffer();

                for (int i = 0; i < MAX_ITEMS; i++) {
                    if (item_stocks[i] >= sell_qty[i]) {
                        item_stocks[i] -= sell_qty[i];
                        item_total_out[i] += sell_qty[i];
                    }
                    else {
                        int available = item_stocks[i];
                        item_stocks[i] = 0;
                        item_total_out[i] += available;
                        printf("ID %d 재고 부족으로 %d개만 판매 처리됨\n", i + 1, available);
                    }
                }
                printf("-> 전체 상품 판매 처리 완료\n");
            }
            else if (sub_choice == 2) {
                int id, qty;
                printf("(입력)상품ID : ");
                scanf("%d", &id);
                clear_input_buffer();
                printf("(입력)판매수량 : ");
                scanf("%d", &qty);
                clear_input_buffer();

                if (id >= 1 && id <= MAX_ITEMS) {
                    int idx = id - 1;
                    if (item_stocks[idx] >= qty) {
                        item_stocks[idx] -= qty;
                        item_total_out[idx] += qty;
                        printf("-> 상품 ID %d 판매 완료. 현재 재고: %d\n", id, item_stocks[idx]);
                    }
                    else {
                        int available = item_stocks[idx];
                        item_stocks[idx] = 0;
                        item_total_out[idx] += available;
                        printf("! 재고 부족: %d개만 판매 처리합니다.\n", available);
                    }
                }
                else {
                    printf("! 잘못된 상품 ID\n");
                }
            }
            break;
        }
        case 3:
            display_status();
            break;
        case 4:
            printf("\n--- 프로그램 종료 ---\n");
            return 0;
        default:
            printf("! 잘못된 메뉴 선택입니다.\n");
            break;
        }
    }
}
