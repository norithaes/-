#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <string.h>

#define MAX_ITEMS 5
#define NAME_LENGTH 30

char item_names[MAX_ITEMS][NAME_LENGTH];
int item_stocks[MAX_ITEMS];
int item_total_in[MAX_ITEMS];
int item_total_out[MAX_ITEMS];

void initialize_program() {
    for (int i = 0; i < MAX_ITEMS; i++) {
        sprintf(item_names[i], "상품%d", i + 1);
        item_stocks[i] = 0;
        item_total_in[i] = 0;
        item_total_out[i] = 0;
    }
}

void clear_input_buffer() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

void handle_in() {
    int sub_choice;
    printf("\n(출력)입고수량 입력 : 전체 상품 입고수량 입력 1, 개별 상품 입력 2를 선택\n");
    printf(">");
    if (scanf("%d", &sub_choice) != 1) {
        clear_input_buffer();
        return;
    }
    clear_input_buffer();

    if (sub_choice == 1) {
        int temp_in[MAX_ITEMS];
        printf("(입력) 전체 상품의 입고수량을 입력 (예: 10 12 9 4 9)\n>");
        for (int i = 0; i < MAX_ITEMS; i++) {
            scanf("%d", &temp_in[i]);
        }
        clear_input_buffer();

        for (int i = 0; i < MAX_ITEMS; i++) {
            item_stocks[i] += temp_in[i];
            item_total_in[i] += temp_in[i];
        }
    }
    else if (sub_choice == 2) {
        int id, qty;
        printf("(입력)상품ID : ");
        scanf("%d", &id);
        clear_input_buffer();

        printf("(입력)입고수량 : ");
        scanf("%d", &qty);
        clear_input_buffer();

        if (id >= 1 && id <= MAX_ITEMS) {
            item_stocks[id - 1] += qty;
            item_total_in[id - 1] += qty;
        }
    }
}

void handle_out() {
    int sub_choice;
    printf("\n(출력)판매수량 입력 : 전체 상품 판매수량 입력 1, 개별 상품 입력 2를 선택\n");
    printf(">");
    if (scanf("%d", &sub_choice) != 1) {
        clear_input_buffer();
        return;
    }
    clear_input_buffer();

    if (sub_choice == 1) {
        int temp_out[MAX_ITEMS];
        printf("(입력) 전체 상품의 판매수량을 입력\n>");
        for (int i = 0; i < MAX_ITEMS; i++) {
            scanf("%d", &temp_out[i]);
        }
        clear_input_buffer();

        for (int i = 0; i < MAX_ITEMS; i++) {
            if (item_stocks[i] >= temp_out[i]) {
                item_stocks[i] -= temp_out[i];
                item_total_out[i] += temp_out[i];
            }
            else {
                int sold = item_stocks[i];
                item_stocks[i] = 0;
                item_total_out[i] += sold;
            }
        }
    }
    else if (sub_choice == 2) {
        int id, qty;
        printf("(입력)상품ID : ");
        scanf("%d", &id);
        clear_input_buffer();

        printf("(입력)판매수량 : ");
        scanf("%d", &qty);
        clear_input_buffer();

        if (id >= 1 && id <= MAX_ITEMS) {
            int idx = id - 1;
            if (item_stocks[idx] >= qty) {
                item_stocks[idx] -= qty;
                item_total_out[idx] += qty;
            }
            else {
                int sold = item_stocks[idx];
                item_stocks[idx] = 0;
                item_total_out[idx] += sold;
            }
        }
    }
}

void handle_name_input() {
    printf("4 << 상품명입력 메뉴 실행\n");
    for (int i = 0; i < MAX_ITEMS; i++) {
        printf("(출력) ID %d 상품명 : ", i + 1);
        scanf("%s", item_names[i]);
        clear_input_buffer();
    }
}

void display_status() {
    int total_stock = 0;
    int total_sales = 0;
    int total_in = 0;
    
    int max_sales = -1;
    int max_id = 0;
    
    int min_sales = 999999;
    int min_id = 0;

    printf("\n");
    printf("재고수량 : ");
    for (int i = 0; i < MAX_ITEMS; i++) {
        printf("%d ", item_stocks[i]);
        total_stock += item_stocks[i];
        total_sales += item_total_out[i];
        total_in = item_total_in[i]; 

        if (item_total_out[i] > max_sales) {
            max_sales = item_total_out[i];
            max_id = i + 1;
        }
        if (item_total_out[i] < min_sales) {
            min_sales = item_total_out[i];
            min_id = i + 1;
        }
    }
    printf("\n");

    double rate = 0.0;
    int grand_total_in = total_stock + total_sales;
    if (grand_total_in > 0) {
        rate = (double)total_sales / grand_total_in * 100.0;
    }

    printf("총 판매량 : %d (판매율 %.2f%%)\n", total_sales, rate);

    if (max_sales >= 0 && max_id > 0)
        printf("가장 많이 판매된 상품 : ID %d, 상품명 : %s, 판매량 %d\n", max_id, item_names[max_id - 1], max_sales);
    
    if (min_sales != 999999 && min_id > 0)
        printf("가장 적게 판매된 상품 : ID %d, 상품명 : %s, 판매량 %d\n", min_id, item_names[min_id - 1], min_sales);

    for (int i = 0; i < MAX_ITEMS; i++) {
        if (item_stocks[i] < 3) {
            printf("상품 ID %d : 상품명 : %s 재고부족(%d)\n", i + 1, item_names[i], item_stocks[i]);
        }
    }
}

int main() {
    int choice;
    initialize_program();

    while (1) {
        printf("\n원하는 메뉴를 선택하세요.(1. 입고, 2. 판매, 3. 상품현황. 4. 상품명 입력, 5. 종료)\n> ");
        if (scanf("%d", &choice) != 1) {
            clear_input_buffer();
            continue;
        }
        clear_input_buffer();

        switch (choice) {
        case 1:
            handle_in();
            break;
        case 2:
            handle_out();
            break;
        case 3:
            display_status();
            break;
        case 4:
            handle_name_input();
            break;
        case 5:
            printf("프로그램 종료\n");
            return 0;
        default:
            break;
        }
    }
}
