#define _CRT_SECURE_NO_WARNINGS

#include <stdio.h>
#include <string.h>

#define MAX_ITEMS 5
#define NAME_LENGTH 30
#define DATA_FILE "inventory.dat"

char item_names[MAX_ITEMS][NAME_LENGTH];
int item_stocks[MAX_ITEMS];
int item_prices[MAX_ITEMS];
int item_total_in[MAX_ITEMS];
int item_total_out[MAX_ITEMS];
long long item_total_sales_value[MAX_ITEMS];

void initialize_program();
void save_data(); 
void handle_out(int item_id, int quantity);
void display_status();
void display_individual_status(int item_id);
void clear_input_buffer();

void initialize_program() {
    FILE* fp = NULL;

    if (fopen_s(&fp, DATA_FILE, "rb") == 0 && fp != NULL) {
        fread(item_names, sizeof(char[NAME_LENGTH]), MAX_ITEMS, fp);
        fread(item_stocks, sizeof(int), MAX_ITEMS, fp);
        fread(item_prices, sizeof(int), MAX_ITEMS, fp);
        fread(item_total_in, sizeof(int), MAX_ITEMS, fp);
        fread(item_total_out, sizeof(int), MAX_ITEMS, fp);
        fread(item_total_sales_value, sizeof(long long), MAX_ITEMS, fp);

        fclose(fp);
        printf("--- 저장된 [%s] 파일을 불러왔습니다. ---\n", DATA_FILE);
    }
    else {
        for (int i = 0; i < MAX_ITEMS; ++i) {
            item_names[i][0] = '\0'; 
            item_stocks[i] = 0;
            item_prices[i] = 0;
            item_total_in[i] = 0;
            item_total_out[i] = 0;
            item_total_sales_value[i] = 0;
        }
        printf("--- 쇼핑몰 재고 관리 프로그램 시작 ---\n");
        printf("%d개 상품 슬롯이 초기화되었습니다. (데이터 파일 없음)\n", MAX_ITEMS);
    }
}

void save_data() {
    FILE* fp = NULL;

    if (fopen_s(&fp, DATA_FILE, "wb") != 0 || fp == NULL) {
        printf("! 파일 저장 오류: [%s] 파일을 열 수 없습니다.\n", DATA_FILE);
        return;
    }

    fwrite(item_names, sizeof(char[NAME_LENGTH]), MAX_ITEMS, fp);
    fwrite(item_stocks, sizeof(int), MAX_ITEMS, fp);
    fwrite(item_prices, sizeof(int), MAX_ITEMS, fp);
    fwrite(item_total_in, sizeof(int), MAX_ITEMS, fp);
    fwrite(item_total_out, sizeof(int), MAX_ITEMS, fp);
    fwrite(item_total_sales_value, sizeof(long long), MAX_ITEMS, fp);

    fclose(fp);

    printf("-> [%s] 파일에 모든 상품 정보를 저장했습니다.\n", DATA_FILE);
}


void handle_out(int item_id, int quantity) {
    if (item_id < 1 || item_id > MAX_ITEMS) {
        printf("! 잘못된 상품 ID입니다. (1~%d)\n", MAX_ITEMS);
        return;
    }
    if (quantity < 0) {
        printf("! 수량은 0 이상이어야 합니다.\n");
        return;
    }

    int index = item_id - 1;

    if (item_names[index][0] == '\0') {
        printf("! 아직 등록되지 않은 상품 ID입니다. (입고 메뉴에서 먼저 등록하세요)\n");
        return;
    }

    int sold_qty = (item_stocks[index] >= quantity) ? quantity : item_stocks[index];

    item_stocks[index] -= sold_qty;
    item_total_out[index] += sold_qty;
    item_total_sales_value[index] += (long long)sold_qty * item_prices[index];

    if (sold_qty == quantity) {
        printf("-> 상품 ID %d [%s]에서 %d개 판매되었습니다. 현재 재고: %d\n",
            item_id, item_names[index], quantity, item_stocks[index]);
    }
    else {
        printf("! 재고 부족: 상품 ID %d [%s]의 재고가 부족하여 %d개만 판매 처리합니다. (현재 재고: %d)\n",
            item_id, item_names[index], sold_qty, item_stocks[index]);
    }
}

void display_status() {
    int total_stock = 0, total_sales = 0, grand_total_in = 0;
    long long grand_total_sales_value = 0;
    int max_sales_qty = -1, max_sales_qty_id = -1;
    double sales_rate = 0.0;
    int registered_items = 0;

    printf("\n--- 전체 상품 현황 ---\n");
    for (int i = 0; i < MAX_ITEMS; ++i) {
        if (item_names[i][0] == '\0') continue;

        registered_items++;
        total_stock += item_stocks[i];
        total_sales += item_total_out[i];
        grand_total_in += item_total_in[i];
        grand_total_sales_value += item_total_sales_value[i];

        if (item_total_out[i] > max_sales_qty) {
            max_sales_qty = item_total_out[i];
            max_sales_qty_id = i + 1;
        }
    }

    if (registered_items == 0) {
        printf("아직 등록된 상품이 없습니다.\n");
        printf("---------------------------\n");
        return;
    }

    if (grand_total_in > 0) {
        sales_rate = ((double)total_sales / grand_total_in) * 100;
    }

    printf("총 재고수량 : %d\n", total_stock);
    printf("총 판매량 : %d\n", total_sales);
    printf("총 판매금액 : %lld원\n", grand_total_sales_value);
    printf("총 판매율 (입고 대비) : %.2f%%\n", sales_rate);

    if (max_sales_qty > 0) {
        printf("가장 많이 판매된 상품(수량 기준) : ID %d [%s] (판매량 %d개)\n",
            max_sales_qty_id, item_names[max_sales_qty_id - 1], max_sales_qty);
    }
    else {
        printf("아직 판매된 상품이 없습니다.\n");
    }


    printf("\n--- 개별 상품 재고 현황 ---\n");
    for (int i = 0; i < MAX_ITEMS; ++i) {
        if (item_names[i][0] == '\0') continue;

        printf("ID %d [%s] (가격: %d원)\n", i + 1, item_names[i], item_prices[i]);
        printf("  > 현재 재고: %d, 총 판매량: %d, 총 판매금액: %lld원",
            item_stocks[i], item_total_out[i], item_total_sales_value[i]);

        if (item_stocks[i] == 0) printf(" -> 재고부족(0)\n");
        else if (item_stocks[i] < 5) printf(" -> 재고부족(%d)\n", item_stocks[i]);
        else printf("\n");
    }
    printf("---------------------------\n");
}

void display_individual_status(int item_id) {
    if (item_id < 1 || item_id > MAX_ITEMS) {
        printf("! 잘못된 상품 ID입니다. (1~%d)\n", MAX_ITEMS);
        return;
    }
    int index = item_id - 1;

    if (item_names[index][0] == '\0') {
        printf("! 아직 등록되지 않은 상품 ID입니다.\n");
        return;
    }

    printf("\n--- 개별 상품 현황 (ID %d) ---\n", item_id);
    printf("상품명: [%s]\n", item_names[index]);
    printf("상품가격: %d원\n", item_prices[index]);
    printf("현재 재고: %d\n", item_stocks[index]);
    printf("총 입고량: %d\n", item_total_in[index]);
    printf("총 판매량: %d\n", item_total_out[index]);
    printf("총 판매금액: %lld원\n", item_total_sales_value[index]);

    if (item_stocks[index] == 0) printf("상태: 재고부족(0)\n");
    else if (item_stocks[index] < 5) printf("상태: 재고부족(%d)\n", item_stocks[index]);
    else printf("상태: 재고 양호\n");
    printf("----------------------------------\n");
}

void clear_input_buffer() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}


int main() {
    int choice = 0, item_id = 0, quantity = 0;

    initialize_program();

    while (1) {

        printf("\n[쇼핑몰 관리 프로그램]\n");
        printf("1. 입고 | 2. 판매 | 3. 개별현황 | 4. 전체현황 | 5. 저장 | 6. 종료\n");
        printf("원하는 메뉴를 선택하세요: ");

        if (scanf_s("%d", &choice) != 1) {
            clear_input_buffer();
            printf("! 유효하지 않은 입력입니다. 메뉴에 해당하는 숫자를 입력하세요.\n");
            continue;
        }
        clear_input_buffer();

        switch (choice) {
        case 1:
            printf("\n>> 1. 입고 >>\n");

            printf("(입력) 상품 ID (1~%d): ", MAX_ITEMS);
            if (scanf_s("%d", &item_id) != 1) {
                clear_input_buffer();
                printf("! 유효하지 않은 입력입니다.\n");
                break;
            }
            clear_input_buffer();

            if (item_id < 1 || item_id > MAX_ITEMS) {
                printf("! 잘못된 상품 ID입니다. (1~%d 범위 초과)\n", MAX_ITEMS);
                break;
            }
            int index = item_id - 1;

            printf("(입력) 상품명: ");
            if (scanf_s("%s", item_names[index], (unsigned)NAME_LENGTH) != 1) {
                clear_input_buffer();
                printf("! 잘못된 입력입니다.\n");
                break;
            }
            clear_input_buffer();

            printf("(입력) 입고 수량: ");
            if (scanf_s("%d", &quantity) != 1) {
                clear_input_buffer();
                printf("! 유효하지 않은 입력입니다.\n");
                break;
            }
            clear_input_buffer();

            printf("(입력) 판매 가격: ");
            if (scanf_s("%d", &item_prices[index]) != 1 || item_prices[index] < 0) {
                clear_input_buffer();
                printf("! 잘못된 입력입니다. 0 이상의 숫자를 입력하세요.\n");
                break;
            }
            clear_input_buffer();

            if (quantity < 0) {
                printf("! 수량은 0 이상이어야 합니다.\n");
                break;
            }

            item_stocks[index] += quantity;
            item_total_in[index] += quantity;

            printf("-> 상품 ID %d [%s] 정보가 업데이트/생성되었습니다.\n", item_id, item_names[index]);
            printf("   %d개 입고 (가격: %d원). 현재 총 재고: %d\n",
                quantity, item_prices[index], item_stocks[index]);

            break;

        case 2:
            printf("\n>> 2. 판매 >>\n");
            printf("(입력) 판매할 상품 ID (1~%d): ", MAX_ITEMS);
            if (scanf_s("%d", &item_id) != 1) {
                clear_input_buffer();
                printf("! 유효하지 않은 입력입니다.\n");
                break;
            }
            clear_input_buffer();

            printf("(입력) 판매 수량: ");
            if (scanf_s("%d", &quantity) != 1) {
                clear_input_buffer();
                printf("! 유효하지 않은 입력입니다.\n");
                break;
            }
            clear_input_buffer();

            handle_out(item_id, quantity);
            break;

        case 3:
            printf("\n>> 3. 개별 상품 현황 >>\n");
            printf("(입력) 확인할 상품 ID (1~%d): ", MAX_ITEMS);
            if (scanf_s("%d", &item_id) != 1) {
                clear_input_buffer();
                printf("! 유효하지 않은 입력입니다.\n");
                break;
            }
            clear_input_buffer();

            display_individual_status(item_id);
            break;

        case 4:
            display_status();
            break;

        case 5:
            printf("\n>> 5. 저장 >>\n");
            save_data();
            break;

        case 6:
            printf("\n--- 프로그램 종료 ---\n");
            return 0;

        default:
            printf("! 잘못된 메뉴 선택입니다.\n");
            break;
        }
    }
}
